datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

generator client {
  provider = "volan-kotlin"
  package = "org.example.schema.sample7"
  javaFriendly = true
}

model Article {
  id Int @id @default(autoincrement())
  authorId Int
  publishedAt DateTime

  @@index([authorId, publishedAt])
}
