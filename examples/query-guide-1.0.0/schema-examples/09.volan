datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

generator client {
  provider = "volan-kotlin"
  package = "org.example.schema.sample9"
  javaFriendly = true
}

model Account {
  id Int @id @default(autoincrement())
  profile Profile?
}

model Profile {
  id Int @id @default(autoincrement())
  accountId Int @unique
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}
