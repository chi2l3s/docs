            "pages": [
              "en/databases",
              "en/sync",
              "en/migrations",
              "en/production"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "en/cli",
              "en/limitations",
              "en/errors",
              "en/examples",
              "en/versions",
              "en/benchmarks",
              "en/faq"
            ]
